---
import BaseHead from '../components/layout/BaseHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { DEFAULT_LANG, LANGUAGE_TAG, type Lang } from '../lib/i18n';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Language of the page's main content. */
  lang?: Lang;
  /** hreflang alternates, used by translated articles. */
  alternates?: Array<{ lang: Lang; href: string }>;
  /** Extra class on <main>, used by the article layout. */
  mainClass?: string;
}

const { mainClass, lang = DEFAULT_LANG, ...head } = Astro.props;
---

<!doctype html>
<html lang={LANGUAGE_TAG[lang]}>
  <head>
    <BaseHead {...head} lang={lang} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
