---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import RelatedArticles from '../components/article/RelatedArticles.astro';
import type { Article } from '../lib/content';
import { articleUrl } from '../lib/content';
import { formatDate, isoDate, readingTimeMinutes, slugify } from '../lib/text';
import { SITE_TITLE, SITE_URL, AUTHOR } from '../consts';
import 'katex/dist/katex.min.css';
import '../styles/prose.css';
import '../styles/blocks.css';
import '../styles/figure.css';

interface Props {
  article: Article;
  headings: MarkdownHeading[];
  related: Article[];
  newer?: Article;
  older?: Article;
}

const { article, headings, related, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, topics, draft } = article.data;
const minutes = readingTimeMinutes(article.body ?? '');
const url = new URL(articleUrl(article), SITE_URL).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: AUTHOR },
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  keywords: [...topics, ...tags].join(', '),
  inLanguage: 'en',
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  image={`/og/${article.id}.png`}
  imageAlt={`${title} — ${SITE_TITLE}`}
  noindex={draft}
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class="article-shell">
    <header class="article-head page">
      {draft && <p class="draft-flag">Draft — not yet published</p>}
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>
      <p class="article-meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        <span aria-hidden="true">·</span>
        <span>{AUTHOR}</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
      </p>
      {
        topics.length > 0 && (
          <ul class="tag-list article-topics">
            {topics.map((topic) => (
              <li>
                <a class="tag" href={`/topics/${slugify(topic)}/`}>
                  {topic}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <TableOfContents headings={headings} />
    <script is:inline>
      // The contents list is a <details> so that it can be collapsed on small
      // screens; in the wide-screen margin layout it is always open.
      if (window.matchMedia('(min-width: 1460px)').matches) {
        document.getElementById('toc')?.setAttribute('open', '');
      }
    </script>

    <div class="prose">
      <slot />
    </div>
  </article>

  <footer class="article-foot page">
    {
      tags.length > 0 && (
        <section class="foot-block">
          <h2 class="eyebrow">Tags</h2>
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <span class="tag">{tag}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (newer || older) && (
        <nav class="foot-block pager" aria-label="More articles">
          {older && (
            <a class="pager__item" href={articleUrl(older)} rel="prev">
              <span class="eyebrow">Previous</span>
              <span>{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="pager__item pager__item--next" href={articleUrl(newer)} rel="next">
              <span class="eyebrow">Next</span>
              <span>{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    <RelatedArticles articles={related} />

    {
      related.length === 0 && !newer && !older && (
        <section class="foot-block foot-note">
          <h2 class="eyebrow">More to come</h2>
          <p>
            This is the first article on {SITE_TITLE}. New pieces appear every few weeks —
            <a href="/rss.xml">follow the feed</a> or <a href="/blog/">check the archive</a>.
          </p>
        </section>
      )
    }
  </footer>
</BaseLayout>

<style>
  .article-shell {
    position: relative;
    padding-block-start: var(--s-7);
  }
  .article-head {
    max-width: calc(var(--w-prose) + var(--gutter) * 2);
    margin-inline: auto;
    padding-block-end: var(--s-6);
  }
  .article-head h1 {
    font-family: var(--f-serif);
    font-size: clamp(1.9rem, 1.35rem + 2.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 600;
    text-wrap: balance;
  }
  .standfirst {
    font-family: var(--f-serif);
    font-size: clamp(1.075rem, 1rem + 0.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--c-ink-soft);
    margin-block-start: var(--s-4);
    max-width: 34em;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
    margin-block-start: var(--s-5);
  }
  .article-topics {
    margin-block-start: var(--s-4);
  }
  .draft-flag {
    display: inline-block;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-accent-deep);
    border: 1px solid var(--c-accent);
    border-radius: var(--radius);
    padding: 0.15em 0.6em;
    margin-block-end: var(--s-4);
  }

  .article-foot {
    max-width: calc(var(--w-wide) + var(--gutter) * 2);
    margin-inline: auto;
    margin-block-start: var(--s-8);
  }
  .foot-block + .foot-block,
  .article-foot :global(.related) {
    margin-block-start: var(--s-7);
  }
  .foot-note {
    border-top: var(--border);
    padding-block-start: var(--s-5);
  }
  .foot-note .eyebrow {
    display: block;
    margin-block-end: var(--s-3);
  }
  .foot-note p {
    font-family: var(--f-serif);
    font-size: var(--fs-md);
    color: var(--c-ink-soft);
    max-width: 34em;
  }
  .foot-note a {
    color: var(--c-accent-deep);
  }
  .pager {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    border-top: var(--border);
    padding-block-start: var(--s-5);
  }
  .pager__item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    font-family: var(--f-serif);
    font-size: var(--fs-md);
    color: var(--c-ink);
    line-height: 1.35;
  }
  .pager__item:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-underline-offset: 0.18em;
  }
  .pager__item--next {
    text-align: right;
  }
  @media (max-width: 600px) {
    .pager__item--next {
      text-align: left;
    }
  }

  /* Reading progress: pure CSS scroll-driven animation where supported, and
     simply invisible where it is not. No JavaScript, no scroll listener. */
  /* Sits above the sticky header so its position does not depend on the
     header's height, which changes when the navigation wraps. */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: var(--c-accent);
    z-index: 21;
    opacity: 0.9;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        animation: progress-grow linear;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes progress-grow {
    to {
      transform: scaleX(1);
    }
  }
</style>
