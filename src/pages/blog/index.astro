---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveView from '../../components/article/ArchiveView.astro';
import { getArticles } from '../../lib/content';
import { SITE_TITLE } from '../../consts';

const articles = await getArticles();
---

<BaseLayout
  title="Writing"
  description={`Every article published on ${SITE_TITLE}: mathematical essays in English and Vietnamese, with interactive visualizations.`}
>
  <ArchiveView articles={articles} all={articles} active="all" />
</BaseLayout>
