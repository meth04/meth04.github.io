---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, articleUrl, articleSummary, languageCounts } from '../lib/content';
import { formatDateIn, LANGUAGES, LANGUAGE_NAME, LANGUAGE_BADGE } from '../lib/i18n';

// The full list is rendered server-side so that the page is useful with
// JavaScript switched off, and so that there is something to read before the
// index has been fetched.
const articles = await getArticles();
const counts = languageCounts(articles);
const available = LANGUAGES.filter((lang) => (counts.get(lang) ?? 0) > 0);
---

<BaseLayout
  title="Search"
  description="Search every article on Math in Motion by title, topic, tag or body text."
  noindex={true}
>
  <div class="page search">
    <h1>Search</h1>
    <p class="lede">Searches titles, descriptions, topics, tags and article text.</p>

    <form class="search__form" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="q">Search articles</label>
      <input
        type="search"
        id="q"
        name="q"
        placeholder="gradient, learning rate, convexity…"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="submit" class="viz-btn" data-variant="primary">Search</button>
    </form>

    {
      available.length > 1 && (
        <div class="search__langs" role="group" aria-label="Filter by language" id="lang-filter">
          <button type="button" class="lang-chip" data-lang="all" aria-pressed="true">
            All languages <span class="lang-chip__count">{articles.length}</span>
          </button>
          {available.map((lang) => (
            <button type="button" class="lang-chip" data-lang={lang} aria-pressed="false">
              <span lang={lang}>{LANGUAGE_NAME[lang]}</span>
              <span class="lang-chip__count">{counts.get(lang)}</span>
            </button>
          ))}
        </div>
      )
    }

    <p class="search__status" id="search-status" role="status" aria-live="polite"></p>

    <ol class="results" id="results" hidden></ol>

    <section id="all-articles">
      <h2 class="eyebrow">All articles</h2>
      <ol class="results results--static">
        {
          articles.map((article) => (
            <li data-lang={article.data.lang}>
              <a href={articleUrl(article)} lang={article.data.lang}>
                {article.data.title}
              </a>
              <p class="results__meta">
                <span class="results__badge">{LANGUAGE_BADGE[article.data.lang]}</span>
                {formatDateIn(article.data.pubDate, article.data.lang)}
              </p>
              <p class="results__snippet" lang={article.data.lang}>
                {articleSummary(article)}
              </p>
            </li>
          ))
        }
        {articles.length === 0 && <li class="results__empty">No articles published yet.</li>}
      </ol>
    </section>
  </div>
</BaseLayout>

<script>
  import { search, highlight, tokenize, type SearchDocument } from '../lib/search';

  const input = document.getElementById('q') as HTMLInputElement | null;
  const list = document.getElementById('results') as HTMLOListElement | null;
  const statusEl = document.getElementById('search-status');
  const staticList = document.getElementById('all-articles');
  const form = document.querySelector<HTMLFormElement>('.search__form');
  const langButtons = [...document.querySelectorAll<HTMLButtonElement>('#lang-filter .lang-chip')];
  if (input && list && statusEl && staticList && form) {
    let documents: SearchDocument[] | null = null;
    let loading: Promise<void> | null = null;
    let activeLang = 'all';

    const load = (): Promise<void> => {
      if (documents) return Promise.resolve();
      if (!loading) {
        loading = fetch('/search-index.json')
          .then((r) => r.json())
          .then((data: { documents: SearchDocument[] }) => {
            documents = data.documents;
          })
          .catch(() => {
            statusEl.textContent =
              'The search index could not be loaded. The full list of articles is below.';
          });
      }
      return loading;
    };

    const render = (query: string): void => {
      if (!documents) return;
      const trimmed = query.trim();
      if (trimmed.length === 0) {
        list.hidden = true;
        list.textContent = '';
        staticList.hidden = false;
        statusEl.textContent = '';
        return;
      }

      const terms = tokenize(trimmed);
      const results = search(documents, trimmed, 12, activeLang);
      staticList.hidden = true;
      list.hidden = false;
      list.textContent = '';

      const scope =
        activeLang === 'all'
          ? ''
          : ` in ${
              langButtons
                .find((b) => b.dataset.lang === activeLang)
                ?.textContent?.trim()
                .replace(/\s+\d+$/, '') ?? activeLang
            }`;
      statusEl.textContent =
        results.length === 0
          ? `No articles match “${trimmed}”${scope}. Try a broader word, another language, or browse the topics page.`
          : `${results.length} result${results.length === 1 ? '' : 's'} for “${trimmed}”${scope}.`;

      for (const result of results) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = result.doc.url;
        for (const part of highlight(result.doc.title, terms)) {
          const node = part.hit
            ? document.createElement('mark')
            : document.createTextNode(part.text);
          if (part.hit) node.textContent = part.text;
          link.append(node);
        }
        link.lang = result.doc.lang;
        const meta = document.createElement('p');
        meta.className = 'results__meta';
        const badge = document.createElement('span');
        badge.className = 'results__badge';
        badge.textContent = result.doc.lang.toUpperCase();
        meta.append(badge, [result.doc.date, ...result.doc.topics].join(' · '));
        const snippet = document.createElement('p');
        snippet.className = 'results__snippet';
        snippet.lang = result.doc.lang;
        for (const part of highlight(result.snippet, terms)) {
          const node = part.hit
            ? document.createElement('mark')
            : document.createTextNode(part.text);
          if (part.hit) node.textContent = part.text;
          snippet.append(node);
        }
        item.append(link, meta, snippet);
        list.append(item);
      }
    };

    let timer = 0;
    const onInput = (): void => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        void load().then(() => render(input.value));
      }, 120);
    };

    // Language chips filter both the live results and the static article list,
    // so the page behaves the same before and after a query is typed.
    const applyLanguage = (): void => {
      for (const button of langButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.lang === activeLang));
      }
      for (const item of staticList.querySelectorAll<HTMLLIElement>('li[data-lang]')) {
        item.hidden = activeLang !== 'all' && item.dataset.lang !== activeLang;
      }
      render(input.value);
    };

    for (const button of langButtons) {
      button.addEventListener('click', () => {
        activeLang = button.dataset.lang ?? 'all';
        void load().then(applyLanguage);
      });
    }

    input.addEventListener('input', onInput);
    input.addEventListener('focus', () => void load(), { once: true });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void load().then(() => render(input.value));
    });

    // Support /search/?q=… so results can be linked to and reloaded.
    const initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      void load().then(() => render(initial));
    }
  }
</script>

<style>
  .search {
    padding-block: var(--s-7) var(--s-8);
    max-width: calc(var(--w-wide) + var(--gutter) * 2);
  }
  h1 {
    font-family: var(--f-serif);
    font-size: clamp(1.8rem, 1.4rem + 2vw, 2.6rem);
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .lede {
    margin-block-start: var(--s-3);
    color: var(--c-ink-muted);
  }
  .search__form {
    display: flex;
    gap: var(--s-3);
    margin-block-start: var(--s-5);
    max-width: 34rem;
  }
  .search__form input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.6rem 0.8rem;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--c-bg-raised);
    font-size: var(--fs-md);
    min-height: 2.75rem;
  }
  .search__form input:focus-visible {
    outline: var(--ring);
    outline-offset: 2px;
  }
  .search__form .viz-btn {
    appearance: none;
    border: 1px solid var(--c-accent);
    background: var(--c-accent);
    color: #fff;
    border-radius: var(--radius);
    padding: 0.5rem 1rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    min-height: 2.75rem;
    cursor: pointer;
  }
  .search__form .viz-btn:hover {
    background: var(--c-accent-deep);
    border-color: var(--c-accent-deep);
  }
  .search__langs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }
  .lang-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    appearance: none;
    font-family: var(--f-sans);
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
    border: var(--border);
    border-radius: 999px;
    padding: 0.35em 0.9em;
    background: var(--c-bg-raised);
    min-height: 2.25rem;
    cursor: pointer;
  }
  .lang-chip:hover {
    color: var(--c-ink);
    border-color: var(--c-rule-strong);
  }
  .lang-chip[aria-pressed='true'] {
    color: var(--c-bg-raised);
    background: var(--c-ink);
    border-color: var(--c-ink);
  }
  .lang-chip__count {
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    opacity: 0.75;
  }
  .results__badge {
    display: inline-block;
    margin-inline-end: 0.5em;
    font-size: 0.9em;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--c-ink-muted);
    border: 1px solid var(--c-rule-strong);
    border-radius: 3px;
    padding: 0 0.35em;
  }
  .search__status {
    margin-block-start: var(--s-4);
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
    min-height: 1.4em;
  }
  #all-articles .eyebrow {
    display: block;
    margin-block: var(--s-6) var(--s-3);
  }
  .results {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
  }
  .results li {
    padding-block: var(--s-4);
    border-bottom: var(--border);
  }
  .results a {
    font-family: var(--f-serif);
    font-size: var(--fs-lg);
    font-weight: 600;
    text-decoration: none;
    line-height: 1.3;
  }
  .results a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-underline-offset: 0.18em;
  }
  .results__meta {
    margin-block-start: var(--s-1);
    font-size: var(--fs-xs);
    color: var(--c-ink-faint);
  }
  .results__snippet {
    margin-block-start: var(--s-2);
    color: var(--c-ink-soft);
    font-size: var(--fs-sm);
    line-height: 1.55;
    max-width: 46em;
  }
  .results :global(mark) {
    background: var(--c-accent-wash);
    color: inherit;
    padding: 0 0.1em;
    border-radius: 2px;
  }
  .results__empty {
    color: var(--c-ink-muted);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
