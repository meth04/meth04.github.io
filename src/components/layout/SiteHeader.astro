---
import { SITE_TITLE, NAV } from '../../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="page bar">
    <a class="wordmark" href="/">
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M4 7h16L12 20Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    backdrop-filter: saturate(1.1) blur(6px);
    border-bottom: var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.5rem;
    flex-wrap: wrap;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    /* Keeps the mark clear of the viewport edge when the bar wraps to two
       rows on very narrow phones. */
    padding-block: 0.6rem;
    gap: 0.5rem;
    font-weight: 600;
    font-size: var(--fs-sm);
    letter-spacing: 0.005em;
    text-decoration: none;
    color: var(--c-ink);
    white-space: nowrap;
  }
  .wordmark .mark {
    width: 1rem;
    height: 1rem;
    color: var(--c-accent);
    flex: none;
  }
  .wordmark:hover .mark {
    color: var(--c-accent-deep);
  }
  nav ul {
    display: flex;
    gap: clamp(0.75rem, 3vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
    text-decoration: none;
    padding-block: 0.75rem;
  }
  nav a:hover {
    color: var(--c-ink);
  }
  nav a[aria-current='page'] {
    color: var(--c-ink);
    box-shadow: inset 0 -1px 0 0 var(--c-accent);
  }
  @media (max-width: 400px) {
    .wordmark span {
      /* Keep the mark and full nav on one row on very narrow phones. */
      font-size: 0.8125rem;
    }
    nav a {
      font-size: 0.8125rem;
    }
  }
</style>
