---
import type { Article } from '../../lib/content';
import { articleUrl } from '../../lib/content';
import { isoDate, readingTimeMinutes } from '../../lib/text';
import { formatDateIn, t, LANGUAGE_BADGE, LANGUAGE_NAME } from '../../lib/i18n';

interface Props {
  article: Article;
  /** Larger treatment used for the featured article on the homepage. */
  size?: 'default' | 'lead';
  /** Heading level, so the card fits the surrounding document outline. */
  level?: 2 | 3;
  /** Show the language badge. Off on single-language listings. */
  showLanguage?: boolean;
}
const { article, size = 'default', level = 3, showLanguage = true } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const { title, description, pubDate, topics, lang } = article.data;
const minutes = readingTimeMinutes(article.body ?? '');
const strings = t(lang);
---

<article class:list={['card', size === 'lead' && 'card--lead']}>
  <Heading class="card__title">
    <a href={articleUrl(article)} lang={lang} hreflang={lang}>{title}</a>
    {
      showLanguage && (
        <span class="card__lang" title={LANGUAGE_NAME[lang]}>
          <span class="visually-hidden">{LANGUAGE_NAME[lang]}</span>
          <span aria-hidden="true">{LANGUAGE_BADGE[lang]}</span>
        </span>
      )
    }
  </Heading>
  <p class="card__meta">
    <time datetime={isoDate(pubDate)}>{formatDateIn(pubDate, lang)}</time>
    <span aria-hidden="true">·</span>
    <span>{strings.minRead(minutes)}</span>
    {
      topics.length > 0 && (
        <>
          <span aria-hidden="true">·</span>
          <span>{topics.join(', ')}</span>
        </>
      )
    }
  </p>
  <p class="card__desc" lang={lang}>{description}</p>
</article>

<style>
  .card {
    padding-block: var(--s-5);
    border-top: var(--border);
  }
  .card__title {
    font-family: var(--f-serif);
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.45rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .card__lang {
    display: inline-block;
    vertical-align: 0.22em;
    margin-inline-start: 0.55rem;
    font-family: var(--f-sans);
    font-size: 0.6em;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--c-ink-muted);
    border: 1px solid var(--c-rule-strong);
    border-radius: 3px;
    padding: 0.1em 0.4em;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .card__title a {
    text-decoration: none;
    background-image: linear-gradient(var(--c-accent), var(--c-accent));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 220ms var(--ease);
  }
  .card__title a:hover {
    background-size: 100% 1px;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
    margin-block-start: var(--s-2);
  }
  .card__desc {
    margin-block-start: var(--s-3);
    color: var(--c-ink-soft);
    max-width: 42rem;
    font-size: var(--fs-md);
    line-height: 1.6;
  }
  .card--lead {
    border-top: 2px solid var(--c-ink);
    padding-block-start: var(--s-4);
  }
  .card--lead .card__title {
    font-size: clamp(1.55rem, 1.2rem + 1.8vw, 2.15rem);
  }
  .card--lead .card__desc {
    font-size: var(--fs-lg);
    line-height: 1.55;
  }
</style>
